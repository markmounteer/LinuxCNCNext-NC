#!/bin/sh
# LinuxCNC passes the input filename as the only argument. G-code only on stdout.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'Next-NC NODE_MISSING: Install Node.js 20 or newer and make node available on the LinuxCNC PATH. No G-code was written.' >&2
  exit 127
fi
exec node "$script_dir/nextnc.js" filter "$@"
